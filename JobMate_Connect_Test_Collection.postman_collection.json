                                    "    pm.expect(jsonData.data.companyName).to.eql('Trung tâm Anh ngữ ILA');",
                                    "});",
                                    "",
                                    "pm.test(\"Response has applicationCount field\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.data).to.have.property('applicationCount');",
                                    "    pm.expect(jsonData.data.applicationCount).to.eql(0);",
                                    "});",
                                    "",
                                    "pm.test(\"Response has salaryUnit field\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.data).to.have.property('salaryUnit');",
